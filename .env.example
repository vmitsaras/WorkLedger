# Local development only. Do not use these values for a deployed installation.
WORKLEDGER_ENVIRONMENT=development
WORKLEDGER_ORIGIN=http://127.0.0.1:5173
WORKLEDGER_TRUSTED_PROXY_ADDRESSES=
WORKLEDGER_DATABASE_URL=postgres://workledger_app:workledger_dev_password@127.0.0.1:54329/workledger_dev
WORKLEDGER_ORGANIZATION_NAME=Northstar Studio
WORKLEDGER_ORGANIZATION_LOGO_PATH=
WORKLEDGER_ORGANIZATION_FAVICON_PATH=
WORKLEDGER_ORGANIZATION_ACCENT_COLOR=

# Inactive private local interpretation adapter. Disabled makes no provider network request.
WORKLEDGER_AI_PROVIDER_MODE=disabled
# Inactive adapter from the closed local AI pilot. Keep mode disabled in accepted deployments.
# The values remain blank unless a future separately accepted model gate replaces this decision.
WORKLEDGER_OLLAMA_ORIGIN=
WORKLEDGER_OLLAMA_MODEL=
WORKLEDGER_OLLAMA_MODEL_DIGEST=
WORKLEDGER_OLLAMA_TIMEOUT_SECONDS=
WORKLEDGER_OLLAMA_CONCURRENCY=

# Required for production. Generate a unique value with at least 32 bytes and
# supply it through the deployment environment, never a tracked file.
WORKLEDGER_AUTH_SECRET=
