# Copy to a host-only environment file. Never commit the referenced secret files.
WORKLEDGER_ORIGIN_HOST=time.example.org
WORKLEDGER_ORIGIN=https://time.example.org
WORKLEDGER_ORGANIZATION_NAME=Example Organization
WORKLEDGER_ORGANIZATION_LOGO_PATH=
WORKLEDGER_ORGANIZATION_FAVICON_PATH=
WORKLEDGER_ORGANIZATION_ACCENT_COLOR=
WORKLEDGER_AI_PROVIDER_MODE=disabled
# Keep disabled until a separately authorized local enablement; see docs/202-local-provider-readiness.md.
# These examples are retained only for a future separately accepted model gate.
# WORKLEDGER_OLLAMA_ORIGIN=http://ollama:11434
# WORKLEDGER_OLLAMA_MODEL=example-model:local
# WORKLEDGER_OLLAMA_MODEL_DIGEST=<64-character-lowercase-digest>
# WORKLEDGER_OLLAMA_TIMEOUT_SECONDS=30
# WORKLEDGER_OLLAMA_CONCURRENCY=2
# Only needed with infra/compose/identity-assets.yml.
# WORKLEDGER_IDENTITY_ASSETS_DIRECTORY=/etc/workledger/identity
WORKLEDGER_AUTH_SECRET_FILE=/etc/workledger/secrets/auth_secret
WORKLEDGER_DATABASE_URL_FILE=/etc/workledger/secrets/database_url
WORKLEDGER_POSTGRES_PASSWORD_FILE=/etc/workledger/secrets/postgres_password
POSTGRES_DB=workledger
POSTGRES_USER=workledger
