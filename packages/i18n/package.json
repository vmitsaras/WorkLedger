{
  "name": "@workledger/i18n",
  "version": "0.16.0",
  "private": true,
  "description": "Private WorkLedger internationalization runtime and catalog boundary.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "scripts": {
    "build": "tsc --build tsconfig.json --pretty false",
    "typecheck": "tsc --build tsconfig.json --pretty false"
  },
  "dependencies": {
    "@workledger/contracts": "workspace:*",
    "i18next": "26.4.0",
    "react-aria": "3.51.0",
    "react-i18next": "17.0.12"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@workledger/config": "workspace:*",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "peerDependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  }
}
