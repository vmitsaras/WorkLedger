{
  "name": "@workledger/database",
  "version": "0.10.0",
  "private": true,
  "description": "Private WorkLedger persistence boundary.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build tsconfig.json --pretty false",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "typecheck": "tsc --build tsconfig.json --pretty false"
  },
  "dependencies": {
    "@workledger/domain": "workspace:*",
    "better-auth": "1.6.26",
    "drizzle-orm": "0.45.2",
    "pg": "8.22.0"
  },
  "devDependencies": {
    "@types/pg": "8.20.0",
    "@workledger/config": "workspace:*",
    "@workledger/test-utils": "workspace:*",
    "drizzle-kit": "0.31.10"
  }
}
