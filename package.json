{
  "name": "workledger",
  "version": "0.16.0",
  "private": true,
  "description": "Self-hosted working-time, absence, approval, and monthly-record application.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": "24.18.x",
    "pnpm": ">=11.0.0 <12.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.18.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "preinstall": "node scripts/check-toolchain.mjs",
    "toolchain:check": "node scripts/check-toolchain.mjs",
    "workspace:check": "node scripts/run-verification.mjs workspace:check",
    "phase:check": "node scripts/check-phase-version.mjs",
    "i18n:check": "node scripts/check-i18n.mjs",
    "css:check": "node scripts/check-css-contract.mjs",
    "config:check": "node scripts/run-verification.mjs config:check",
    "production:config:check": "docker compose --env-file .env.production.example -f infra/compose/production.yml config --quiet",
    "production:verify": "node scripts/check-production-deployment.mjs",
    "backup:create": "node scripts/workledger-backup.mjs",
    "backup:restore": "node scripts/workledger-restore.mjs",
    "upgrade:test": "node scripts/workledger-upgrade-test.mjs",
    "db:up": "docker compose -f infra/compose/postgres.dev.yml up -d --wait",
    "db:down": "docker compose -f infra/compose/postgres.dev.yml down",
    "db:reset": "docker compose -f infra/compose/postgres.dev.yml down --volumes --remove-orphans",
    "db:check": "node scripts/check-postgres-dev.mjs",
    "db:test": "pnpm run test:build && node scripts/run-postgres-integration.mjs",
    "db:verify": "pnpm run db:check && pnpm run db:test",
    "db:seed:development": "pnpm run test:build && node packages/database/dist/seed/development-cli.js",
    "openapi:generate": "pnpm run test:build && node scripts/generate-openapi.mjs",
    "openapi:check": "node scripts/run-verification.mjs openapi:check",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "node scripts/run-verification.mjs format:check",
    "lint": "node scripts/run-verification.mjs lint",
    "typecheck": "node scripts/run-verification.mjs typecheck",
    "test:build": "node scripts/run-verification.mjs test:build",
    "test": "node scripts/run-verification.mjs test",
    "test:integration": "node scripts/run-verification.mjs test:integration",
    "test:ai:employee": "node scripts/run-pilot.mjs",
    "test:ai:topics": "node scripts/evaluate-employee-topics.mjs",
    "test:e2e": "node scripts/run-verification.mjs test:e2e",
    "test:visual": "pnpm run workspace:check && pnpm run test:build && WORKLEDGER_ASSERT_PHASE_13_VISUALS=1 playwright test apps/web/e2e/application-shell.spec.ts --project=chromium",
    "test:visual:i18n": "pnpm run workspace:check && pnpm run test:build && WORKLEDGER_ASSERT_PHASE_14_I18N_VISUALS=1 playwright test apps/web/e2e/application-shell.spec.ts --project=chromium --grep 'critical employee routes|responsive manager, HR, and system workflows'",
    "build": "node scripts/run-verification.mjs build",
    "verify": "node scripts/run-verification.mjs",
    "pilot": "node scripts/run-pilot.mjs"
  },
  "devDependencies": {
    "@babel/parser": "8.0.4",
    "@playwright/test": "1.61.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "es-module-lexer": "2.3.1",
    "eslint": "10.8.0",
    "jsdom": "30.0.1",
    "pg": "8.22.0",
    "prettier": "3.9.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "terser": "5.50.0",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "@types/pino": "7.0.5",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3"
  }
}
